# AI providers (server-side only). Without a key the provider runs in mock mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
CLAUDE_MODEL=claude-opus-5
OPENAI_MODEL=gpt-4.1

# Supabase (required for Vercel deploy; omit for local in-memory mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
